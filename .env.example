# Copia este archivo como .env.local (desarrollo) o configura la variable en Vercel.
# Nunca subas a Git un archivo .env con valores reales.

# Endpoint público de tu formulario de Formspree (https://formspree.io).
# Formato: https://formspree.io/f/<ID_DEL_FORMULARIO>
# Es público por diseño (no es una clave secreta), pero se incrusta al compilar:
# si lo cambias, vuelve a ejecutar el build o redespliega en Vercel.
NEXT_PUBLIC_FORMSPREE_ENDPOINT=
